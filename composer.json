{
    "name": "ebrana/elasticsearch-bundle",
    "license": "MIT",
    "type": "library",
    "autoload": {
        "psr-4": {
            "Elasticsearch\\": "src/Elasticsearch"
        }
    },
    "require": {
        "php": ">=8.3.0",
        "ebrana/elasticsearch": "~v1.1.0",
	    "netom/lz-string-php": "~v1.3",
        "symfony/framework-bundle": "~7.1 | ~8.0 | ~8.1",
        "symfony/security-csrf": "~7.1 | ~8.0 | ~8.1",
        "ext-json": "*"
    },
    "require-dev": {
        "phpstan/phpstan": "~1.10.47"
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": true
        }
    }
}
